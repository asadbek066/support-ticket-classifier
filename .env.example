# Environment variables the service reads. Everything else (model, Ollama URL,
# categories, limits) lives in config.yaml. The app does not load a .env file
# itself: export these, or pass the file to your process manager
# (for example `uvicorn app.main:app --env-file .env`).

# Required for the admin endpoints (/audit-logs, /low-confidence-*, /reload-config,
# /verify-ollama-connection). Until it is set they answer 503.
# Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
TICKET_CLASSIFIER_ADMIN_TOKEN=replace-with-a-long-random-value

# Optional shared secret for /classify and /classify-batch (16 to 256 ASCII
# characters, sent as X-Classify-Token). Leave it UNSET to keep those endpoints
# open; a variable that is set but empty or too short makes them answer 503.
# TICKET_CLASSIFIER_CLASSIFY_TOKEN=

# Outbound proxies: HTTP_PROXY / HTTPS_PROXY / NO_PROXY are honoured for
# non-local Ollama hosts only. Loopback and private addresses always bypass them.
